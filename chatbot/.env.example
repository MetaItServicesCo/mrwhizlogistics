# Chatbot service settings for LOCAL development (copy to chatbot/.env).
# In production these come from docker-compose.prod.yml and the root .env.

DATABASE_URL=postgresql://postgres:postgres@localhost:5434/truck_dispatch
# Same value as the backend's SECRET_KEY (verifies dashboard logins).
SECRET_KEY=change-me
# Same value as the backend's CHATBOT_SERVICE_TOKEN.
SERVICE_TOKEN=change-me
BACKEND_URL=http://127.0.0.1:8010
SITE_INTERNAL_URL=http://127.0.0.1:3100
SITE_PUBLIC_URL=http://127.0.0.1:3100
CORS_ORIGINS=http://127.0.0.1:3100,http://localhost:3100

# "groq" with a key, or "fake" to run offline (deterministic test model).
LLM_PROVIDER=groq
GROQ_API_KEY=
# CHAT_MODEL=openai/gpt-oss-120b
# ROUTER_MODEL=openai/gpt-oss-20b
# FALLBACK_MODEL=openai/gpt-oss-20b

# Optional conversation tracing (LangSmith). Leave unset to disable.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=mrwhiz-assistant
