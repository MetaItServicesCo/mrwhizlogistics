# ---------------------------------------------------------------
# Copy to .env on the server and fill in real values.
# docker compose reads this file automatically.
# Never commit the filled-in .env.
# ---------------------------------------------------------------

# --- Database (kept inside the docker network, not exposed) ---
POSTGRES_USER=mrwhiz
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=truck_dispatch

# --- Backend ---
# Generate with:  openssl rand -hex 32
SECRET_KEY=CHANGE_ME_64_hex_chars
ACCESS_TOKEN_EXPIRE_MINUTES=720

# First admin account, created on first boot if it does not exist.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# Browser origins allowed to call the API. Use your real site origin(s),
# comma separated. Do NOT use "*" in production.
CORS_ORIGINS=https://example.com,https://www.example.com

# --- Frontend ---
# Baked into the JS bundle at build time. Must be the public URL of the API.
# With the bundled nginx config the API lives under the same domain.
NEXT_PUBLIC_API_URL=https://example.com

# --- Newsletter email delivery (SMTP) ---
# Use credentials from your email provider. Port 587 normally uses TLS;
# port 465 normally uses SSL (set SMTP_USE_TLS=false, SMTP_USE_SSL=true).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_USE_TLS=true
SMTP_USE_SSL=false
NEWSLETTER_FROM_EMAIL=newsletter@example.com
NEWSLETTER_FROM_NAME=Mr. Whiz Logistics
PUBLIC_SITE_URL=https://example.com

# --- AI chat assistant (chatbot service) ---
# Groq API key: https://console.groq.com/keys
GROQ_API_KEY=CHANGE_ME
# Shared secret between the chatbot and the backend. Generate with:
#   openssl rand -hex 32
CHATBOT_SERVICE_TOKEN=CHANGE_ME_64_hex_chars
# Inbox for "call this visitor now" alerts (needs the SMTP settings above).
# Empty = ADMIN_EMAIL.
DISPATCH_ALERT_EMAIL=dispatch@example.com
# Optional overrides
# Preferred models (the service uses the best one your key can access).
# CHATBOT_CHAT_MODEL=openai/gpt-oss-120b
# CHATBOT_ROUTER_MODEL=openai/gpt-oss-20b
# CHATBOT_FALLBACK_MODEL=openai/gpt-oss-20b
# CHATBOT_DISPATCH_PHONE=(469) 767 8853
# Load testing only (loadtest/README.md). Leave empty normally; remove after a test.
# CHATBOT_LOADTEST_TOKEN=
# Optional LangSmith tracing of conversations
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=

# --- Existing host nginx (docker-compose.host.yml) ---
BACKEND_HOST_PORT=8020
FRONTEND_HOST_PORT=3020
CHATBOT_HOST_PORT=8030
