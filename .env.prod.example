# ---------------------------------------------------------------
# Copy to .env on the server and fill in real values.
# docker compose reads this file automatically.
# Never commit the filled-in .env.
# ---------------------------------------------------------------

# --- Database (kept inside the docker network, not exposed) ---
POSTGRES_USER=mrwhiz
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=truck_dispatch

# --- Backend ---
# Generate with:  openssl rand -hex 32
SECRET_KEY=CHANGE_ME_64_hex_chars
ACCESS_TOKEN_EXPIRE_MINUTES=720

# First admin account, created on first boot if it does not exist.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# Browser origins allowed to call the API. Use your real site origin(s),
# comma separated. Do NOT use "*" in production.
CORS_ORIGINS=https://example.com,https://www.example.com

# --- Frontend ---
# Baked into the JS bundle at build time. Must be the public URL of the API.
# With the bundled nginx config the API lives under the same domain.
NEXT_PUBLIC_API_URL=https://example.com

# --- Existing host nginx (docker-compose.host.yml) ---
BACKEND_HOST_PORT=8002
FRONTEND_HOST_PORT=3003
